# Arı Kaynak — Evidence Verification API
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
#   cp .env.example .env
# GERÇEK API ANAHTARLARINI ASLA COMMIT ETMEYİN.

# --- Genel ---
# Yanıt dili: en | tr
EVIDENCE_LANGUAGE=tr

# Harici kaynak istekleri
EVIDENCE_REQUEST_TIMEOUT_SECONDS=8
EVIDENCE_MAX_RESPONSE_BYTES=1000000
EVIDENCE_MAX_REDIRECTS=3
EVIDENCE_USER_AGENT="AriKaynakEvidence/0.1 (+https://github.com/nitrate07/Blog)"

# --- Kalıcılık ---
EVIDENCE_DATABASE_PATH=evidence/data/evidence.db

# --- API güvenliği ---
# true ise /v1/* uçları X-API-Key ister
EVIDENCE_REQUIRE_API_KEY=true
# İlk kayıt için tek kullanımlık bootstrap anahtarı (opsiyonel)
EVIDENCE_BOOTSTRAP_API_KEY=
# Dakikada istek limiti (anahtar başına)
EVIDENCE_API_RATE_LIMIT_PER_MINUTE=30

# --- LLM sağlayıcı (genel) ---
# Sağlayıcı: claude | openai | gemini | groq
EVIDENCE_LLM_PROVIDER=
EVIDENCE_LLM_API_KEY=
EVIDENCE_LLM_MODEL=
EVIDENCE_LLM_TEMPERATURE=0.0
EVIDENCE_LLM_MAX_TOKENS=4096

# --- LLM sağlayıcı özel (genel ayarları geçersiz kılar) ---
EVIDENCE_CLAUDE_API_KEY=
EVIDENCE_CLAUDE_MODEL=
EVIDENCE_OPENAI_API_KEY=
EVIDENCE_OPENAI_MODEL=
# Groq (ücretsiz katman: console.groq.com, kredi kartı gerekmez)
EVIDENCE_GROQ_API_KEY=
EVIDENCE_GROQ_MODEL=
EVIDENCE_GEMINI_API_KEY=
EVIDENCE_GEMINI_MODEL=

# --- RAG (yerel arşiv arama) ---
EVIDENCE_RAG_PERSIST_DIRECTORY=evidence/data/chroma
EVIDENCE_RAG_ARTICLES_DIR=articles
EVIDENCE_RAG_TR_DIR=tr/makaleler
EVIDENCE_RAG_MAX_RESULTS=10
EVIDENCE_RAG_MAX_CONTEXT_LENGTH=4000
