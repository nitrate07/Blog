# No API key is needed for the deterministic MVP.
EVIDENCE_REQUEST_TIMEOUT_SECONDS=8
EVIDENCE_MAX_RESPONSE_BYTES=1000000
EVIDENCE_MAX_REDIRECTS=3
EVIDENCE_USER_AGENT=AriKaynakEvidence/0.1
# Keep this file private. The bootstrap key is stored only as a hash in SQLite.
EVIDENCE_DATABASE_PATH=evidence/data/evidence.db
EVIDENCE_REQUIRE_API_KEY=true
EVIDENCE_BOOTSTRAP_API_KEY=
EVIDENCE_API_RATE_LIMIT_PER_MINUTE=30

# --- LLM Provider settings (optional) ---
# Falls back to deterministic comparison when no provider is configured.
# Supported providers: claude, openai, gemini, groq

# Generic settings (apply to whichever provider is active)
# EVIDENCE_LLM_PROVIDER=claude
# EVIDENCE_LLM_API_KEY=your-api-key-here
# EVIDENCE_LLM_MODEL=claude-sonnet-5
# EVIDENCE_LLM_TEMPERATURE=0.0
# EVIDENCE_LLM_MAX_TOKENS=256

# Provider-specific settings (override generic when set)
# Configure the ones you want to use; leave the rest commented out.
# EVIDENCE_CLAUDE_API_KEY=your-anthropic-key
# EVIDENCE_CLAUDE_MODEL=claude-sonnet-5
# EVIDENCE_OPENAI_API_KEY=your-openai-key
# EVIDENCE_OPENAI_MODEL=gpt-5.6-terra
# Groq (free tier: console.groq.com, no credit card required)
# EVIDENCE_GROQ_API_KEY=your-groq-key
# EVIDENCE_GROQ_MODEL=openai/gpt-oss-120b
# EVIDENCE_GEMINI_API_KEY=your-google-key
# EVIDENCE_GEMINI_MODEL=gemini-3.7-flash

# --- RAG settings (optional) ---
# EVIDENCE_RAG_PERSIST_DIRECTORY=evidence/data/chroma
# EVIDENCE_RAG_ARTICLES_DIR=articles
# EVIDENCE_RAG_TR_DIR=tr/makaleler
# EVIDENCE_RAG_MAX_RESULTS=10
# EVIDENCE_RAG_MAX_CONTEXT_LENGTH=4000
